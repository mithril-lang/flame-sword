# Keep the real key in .env (ignored by Git) or inject it with 1Password.
MITHRIL_API_KEY=
# Alternatively use an op://vault/item/field reference; only the reference is saved.
MITHRIL_API_KEY_REF=
MITHRIL_MODEL=qwen/qwen3.8-27b
FLAME_SWORD_PORT=5055
# Optional owner-qualified Python verification lane (never supplied by a model).
FLAME_CODE_VERIFIER=
FLAME_CODE_VERIFIER_SHA256=
FLAME_CODE_CONTRACT_SHA256=
FLAME_VERIFY_IMAGE=
# Native consumers must explicitly select their own state and credential owner.
FLAME_PROFILE=local
FLAME_STATE_DIR=
