{
  "name": "fund-mithril-scanner",
  "account_id": "62e1fda53188460698f8c66d3aef59c6",
  "main": "browser/edge.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "dist", "binding": "ASSETS", "run_worker_first": true},
  "services": [
    {"binding": "API_SERVICE", "service": "mithril-api"},
    {"binding": "AUTH_SERVICE", "service": "mithril-auth"}
  ],
  "routes": [{"pattern": "scanner.mithril.fund", "custom_domain": true}],
  "observability": {"enabled": false}
}
